{
  "name": "playwright-french-companies-explorer",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:functional": "playwright test --grep-invert @visual",
    "test:visual": "playwright test tests/visual --project=chromium --workers=1",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep @smoke --project=api --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "allure:clean": "node -e \"const fs=require('node:fs'); fs.rmSync('allure-results',{recursive:true,force:true}); fs.rmSync('allure-report',{recursive:true,force:true});\"",
    "allure:generate": "allure generate allure-results",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure open allure-results",
    "quality:report": "node reporting/scripts/generate-quality-report.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure": "^3.15.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "csv-parse": "^7.0.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "undici-types": "^8.3.0"
  }
}
